{
  "name": "@verity/api",
  "version": "0.1.0",
  "private": true,
  "description": "Verity service: canonical event state, community reports and signals, authentication.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "dev:worker": "tsx watch --env-file-if-exists=.env src/worker/main.ts",
    "start": "node dist/server.js",
    "start:worker": "node dist/worker.js",
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:concurrency": "vitest run test/concurrency",
    "smoke:nimble": "tsx --env-file-if-exists=.env src/scripts/nimble-smoke.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env src/scripts/migrate.ts",
    "db:seed": "tsx --env-file-if-exists=.env src/scripts/seed-dev.ts",
    "db:reset": "tsx --env-file-if-exists=.env src/scripts/reset-dev.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.1",
    "@verity/contracts": "*",
    "better-auth": "1.7.7",
    "drizzle-orm": "^0.45.3",
    "fastify": "^5.12.5",
    "nodemailer": "^10.0.13",
    "pino": "^10.3.1",
    "postgres": "^3.4.9",
    "tldts": "^7.4.16",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.19.1",
    "@types/nodemailer": "^8.0.2",
    "drizzle-kit": "^0.31.11",
    "pino-pretty": "^13.1.3",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "vitest": "^5.0.3"
  }
}
