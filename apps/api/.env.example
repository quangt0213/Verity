# Verity SERVICE configuration (server-side only). Copy to apps/api/.env.
# Never commit real values. None of these may ever be given a VITE_ prefix.
# In development every value is optional: the service runs with an embedded
# database (PGlite), a local email outbox and localhost origins.

# --- Required in production ---------------------------------------------
# Postgres connection string, e.g. postgres://user:password@host:5432/verity?sslmode=require
DATABASE_URL=
# Random secret, at least 32 characters (signs session tokens). Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=
# Public https URL of this service, e.g. https://api.your-verity-domain.example
VERITY_PUBLIC_URL=
# Exact frontend origins allowed to call the API (comma-separated, https, no wildcards).
# After the first Maypop publish, add the Maypop app's exact origin here.
VERITY_ALLOWED_ORIGINS=

# --- Sign-in email (passwordless one-time codes) ---------------------------
# smtp in production; dev-outbox writes emails to DEV_OUTBOX_DIR locally.
AUTH_EMAIL_TRANSPORT=
# Any SMTP provider, e.g. smtps://USERNAME:PASSWORD@smtp.provider.example:465
SMTP_URL=
# Sender, e.g. Verity <no-reply@your-verity-domain.example>
AUTH_EMAIL_FROM=
DEV_OUTBOX_DIR=

# --- Optional -------------------------------------------------------------
# Number of trusted proxy hops in front of the service (e.g. 1 behind a load balancer), or proxy IPs/CIDRs.
TRUST_PROXY=
# Enables /internal/v1 operator endpoints (manual transitions, job inspection). At least 32 characters.
INTERNAL_API_TOKEN=
# Run database migrations automatically at startup (otherwise run: npm run db:migrate -w @verity/api).
MIGRATE_ON_START=
PORT=
HOST=
LOG_LEVEL=

# --- Reserved for later phases (accepted, NOT used yet) -------------------
NIMBLE_API_KEY=
NIMBLE_BASE_URL=
RAWTREE_API_KEY=
RAWTREE_DATABASE=
