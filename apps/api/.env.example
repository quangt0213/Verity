# Verity SERVICE configuration (server-side only). Copy to apps/api/.env.
# Never commit real values. None of these may ever be given a VITE_ prefix.
# In development every value is optional: the service runs with an embedded
# database (PGlite), a local email outbox and localhost origins.

# --- Required in production ---------------------------------------------
# Postgres connection string, e.g. postgres://user:password@host:5432/verity?sslmode=require
DATABASE_URL=
# Random secret, at least 32 characters (signs session tokens). Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=
# Public https URL of this service, e.g. https://api.your-verity-domain.example
VERITY_PUBLIC_URL=
# Exact origins of Verity clients allowed to call the API (comma-separated, https, no wildcards).
# After the first Maypop build, add the Maypop app's exact origin here.
VERITY_ALLOWED_ORIGINS=

# --- Sign-in email (passwordless one-time codes) ---------------------------
# smtp in production; dev-outbox writes emails to DEV_OUTBOX_DIR locally.
AUTH_EMAIL_TRANSPORT=
# Any SMTP provider, e.g. smtps://USERNAME:PASSWORD@smtp.provider.example:465
SMTP_URL=
# Sender, e.g. Verity <no-reply@your-verity-domain.example>
AUTH_EMAIL_FROM=
DEV_OUTBOX_DIR=

# --- Optional -------------------------------------------------------------
# Number of trusted proxy hops in front of the service (e.g. 1 behind a load balancer), or proxy IPs/CIDRs.
TRUST_PROXY=
# Enables /internal/v1 operator endpoints (manual transitions, job inspection). At least 32 characters.
INTERNAL_API_TOKEN=
# Run database migrations automatically at startup (otherwise run: npm run db:migrate -w @verity/api).
MIGRATE_ON_START=
PORT=
HOST=
LOG_LEVEL=

# --- Verification worker ONLY (Phase 3) -----------------------------------
# The API never reads these. Give NIMBLE_API_KEY to the worker process only.
# Required for the worker in production:
NIMBLE_API_KEY=
# Defaults to https://sdk.nimbleway.com, the only host the key is ever sent to.
NIMBLE_BASE_URL=
# Optional budgets and limits. Empty means the default (in parentheses).
# Jobs processed in parallel (2):
VERIFICATION_WORKER_CONCURRENCY=
# Idle poll interval in ms (5000):
VERIFICATION_POLL_INTERVAL_MS=
# Seconds after which a crashed worker's job is reclaimed (600):
VERIFICATION_LEASE_SECONDS=
# Ordinary searches per job (3):
NIMBLE_MAX_SEARCHES_PER_JOB=
# All searches per UTC day; 0 disables search (200):
NIMBLE_DAILY_SEARCH_BUDGET=
# Agent investigations per UTC day; 0 disables them (20):
NIMBLE_DAILY_AGENT_BUDGET=
# Agent effort for conflicting evidence only: low | medium (low). Other cases always use low.
NIMBLE_AGENT_CONFLICT_EFFORT=
# Hours between agent runs for one event (6):
NIMBLE_AGENT_EVENT_COOLDOWN_HOURS=
# Agent runs per event, lifetime (2):
NIMBLE_AGENT_MAX_PER_EVENT=
# Seconds to wait for an agent run before giving up on it (90):
NIMBLE_AGENT_POLL_TIMEOUT_SECONDS=

# --- Reserved for a later phase (accepted, NOT used yet) ------------------
RAWTREE_API_KEY=
RAWTREE_DATABASE=
