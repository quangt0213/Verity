# Verity frontend (Maypop app) — PUBLIC build-time configuration.
#
# Every VITE_* value is compiled into the bundle and visible to anyone who opens
# the app. NEVER put API keys, tokens, passwords or database URLs here.
# The build refuses to run if a VITE_* variable has a secret-like name.
#
# Copy to .env.local (development) or .env.production.local (Maypop publish).

# Data source: "api" (the external Verity service) or "mock" (labeled demo data).
# Leave empty in development to use demo data automatically.
VITE_VERITY_DATA_SOURCE=

# Base URL of the external Verity service. Must be https outside localhost.
VITE_VERITY_API_URL=

# Demo mode only: "simulate" accepts reports/responses in memory (labeled "demo only"),
# "off" refuses them. Defaults to "simulate" in development, "off" in builds.
VITE_MOCK_WRITES=

# Basemap styles (OpenStreetMap-derived). Defaults: OpenFreeMap positron / dark.
VITE_MAP_STYLE_URL_LIGHT=
VITE_MAP_STYLE_URL_DARK=
# Extra origins the basemap needs if its tiles/glyphs live on a different host (comma-separated).
VITE_MAP_EXTRA_ORIGINS=

# Initial map view when no location is known: "lat,lng" and zoom.
VITE_DEFAULT_CENTER=
VITE_DEFAULT_ZOOM=

# Set to "off" only to debug a Content-Security-Policy problem on a new host.
VITE_META_CSP=
