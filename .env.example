# Verity SERVICE secrets (server-side only).
#
# These belong to the external Verity backend (Postgres, Nimble, RawTree,
# verification worker), which is built in the next phases. They are never read
# by the Maypop frontend, and must never be given a VITE_ prefix.
#
# Placeholders only. Real values go in an untracked env file for the service.

NIMBLE_API_KEY=
NIMBLE_BASE_URL=
RAWTREE_API_KEY=
RAWTREE_DATABASE=
DATABASE_URL=
SESSION_SECRET=
